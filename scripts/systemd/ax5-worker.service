[Unit]
Description=AX5 Plotter RQ Worker
After=network.target redis.service
Requires=redis.service

[Service]
Type=simple
User=zimaboard
Group=zimaboard
WorkingDirectory=/home/zimaboard/ax5-plotter-mcp
Environment="PATH=/home/zimaboard/ax5-plotter-mcp/.venv/bin"

# Run the RQ worker
ExecStart=/home/zimaboard/ax5-plotter-mcp/.venv/bin/python src/workers/plot_worker.py

# Restart on failure
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ax5-worker

[Install]
WantedBy=multi-user.target
